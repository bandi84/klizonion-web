# ==============================================================================
# KLIZONION BUILDER - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT: Never commit actual secret keys or credentials to version control.
# Copy this file to .env for local development (which is gitignored).

# ------------------------------------------------------------------------------
# 1. CORE BUILDER & RUNNER SETTINGS
# ------------------------------------------------------------------------------
# PUBLIC: URL for the Builder control plane Worker
BUILDER_API_URL=http://localhost:8787

# SERVER SECRET: Shared secret between local runner and Cloudflare Worker
# Configure in Cloudflare: npx wrangler secret put RUNNER_SHARED_SECRET
RUNNER_SHARED_SECRET=your_runner_shared_secret_here

# ------------------------------------------------------------------------------
# 2. CLOUDFLARE TURNSTILE (CAPTCHA / BOT PROTECTION)
# ------------------------------------------------------------------------------
# PUBLIC: Cloudflare Turnstile Sitekey (used in browser client)
# Test key (always passes): 1x00000000000000000000AA
TURNSTILE_SITEKEY=1x00000000000000000000AA

# SERVER SECRET: Cloudflare Turnstile Secret Key (server-side siteverify only)
# Test secret (always passes): 1x0000000000000000000000000000000AA
# Configure in Cloudflare: npx wrangler secret put TURNSTILE_SECRET
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# ------------------------------------------------------------------------------
# 3. REAL EMAIL VERIFICATION DISPATCH (16-DIGIT CODE DELIVERY)
# ------------------------------------------------------------------------------
# CONFIG: Outbound email HTTPS API endpoint (e.g., Resend: https://api.resend.com/emails)
EMAIL_API_URL=https://api.resend.com/emails

# SERVER SECRET: API key for your email provider (e.g. Resend API key starting with re_...)
# Configure in Cloudflare: npx wrangler secret put EMAIL_API_KEY
EMAIL_API_KEY=your_email_api_key_here

# CONFIG: Sender address (must be a verified domain in Resend/provider, or onboarding@resend.dev for test)
EMAIL_FROM=KLIZONION <onboarding@resend.dev>

# Note: In Cloudflare Workers, you can alternatively bind the native Cloudflare
# Email Routing Service under the binding name EMAIL.


